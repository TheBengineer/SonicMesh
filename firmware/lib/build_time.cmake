# Writes sm_build_time.c with the time of this build. Run on every build (see CMakeLists.txt), so
# `sm info` names the image actually flashed, not the last time shell_cmds.c happened to compile.
string(TIMESTAMP T "%b %d %Y %H:%M:%S")
file(WRITE "${OUT}" "/* Generated by lib/build_time.cmake on every build. */\nconst char sm_build_time[] = \"${T}\";\n")
