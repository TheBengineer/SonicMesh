/* Power the on-board PDM mic at boot and name it for the dmic API. */
/ {
	aliases {
		dmic0 = &pdm0;
	};

	msm261d3526hicpm-c-en {
		regulator-boot-on;
	};
};

&pdm0 {
	status = "okay";
};

/* Battery: VBAT -> 1 M -> P0.31 (AIN7) -> 510 k -> P0.14. lib/battery.c holds P0.14 low. */
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/ {
	zephyr,user {
		io-channels = <&adc 7>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		/* The divider is a high-impedance source (about 340 k): give the sample cap time. */
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
	};
};
